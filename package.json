{
  "name": "bt_fitas",
  "version": "2.0.0",
  "description": "Controle de pedidos, produção e estoque da BT Fitas — versões desktop (Electron) e web (Express), com Prisma",
  "main": "dist-electron/main.js",
  "scripts": {
    "generate": "prisma generate",
    "dev": "npm run dev:desktop",
    "dev:desktop": "prisma generate && vite",
    "dev:web": "prisma generate && tsx watch src/server/server.ts --dev",
    "build": "npm run build:desktop && npm run build:web",
    "build:desktop": "prisma generate && tsc --noEmit && vite build",
    "build:web": "prisma generate && tsc --noEmit && vite build --mode web && vite build --mode web --ssr src/server/server.ts",
    "start:web": "node dist-server/server.cjs",
    "test": "prisma generate && vitest run",
    "dist": "npm run build:desktop && electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.btfitas.app",
    "productName": "BT Fitas",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    }
  }
}
